#!/bin/sh
# Live peer guest init (ADR-0002, ADR-0003). Derived from the SwiftSpice
# Apple/container guest inits (MIT, see NOTICE.md). Layered: the base markers
# come first, the agent stack second, the observers last, so a broken Xorg
# fails only the agent tests.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin HOME=/root DISPLAY=:0 XDG_RUNTIME_DIR=/tmp/runtime-root
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mkdir -p /dev/pts /dev/shm /run/dbus /run/spice-vdagentd "$XDG_RUNTIME_DIR" /tmp/.X11-unix
chmod 0700 "$XDG_RUNTIME_DIR"
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
# The Alpine virt kernel ships these as modules; spice-vdagentd exits without uinput.
for module in virtio_pci virtio_gpu virtio_input evdev uinput drm; do
    if modprobe "$module" 2>/dev/null; then
        echo "GUEST loaded module $module"
    else
        echo "GUEST module $module built in or absent"
    fi
done
echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s
sleep 2
echo "GUEST dri: $(ls /dev/dri 2>/dev/null | tr '\n' ' ')"
echo "GUEST input: $(ls /dev/input 2>/dev/null | tr '\n' ' ')"
echo "GUEST fb: $(ls /dev/fb* 2>/dev/null | tr '\n' ' ')"
# Dump every input event as one hex line; the host requires the injected key here.
(
    while true; do
        for device in /dev/input/event*; do
            test -e "$device" || continue
            name="$(basename "$device")"
            marker="/tmp/monitor-$name"
            test -e "$marker" && continue
            touch "$marker"
            (
                echo "GUEST monitoring $device"
                while true; do
                    if dd if="$device" of="/tmp/$name.event" bs=24 count=1 2>/dev/null; then
                        echo "INPUT_EVENT $device"
                        od -An -tx1 "/tmp/$name.event"
                    fi
                done
            ) &
        done
        sleep 1
    done
) &
echo "GUEST ready"

# Audio: play silence, continuously. The SPICE playback path carries the PCM
# whatever it contains, so a silent stream proves the path end to end without
# making the developer's machine emit a tone. The mixer is set low as well, in
# case a future change plays something audible.
(
    modprobe virtio_snd 2>/dev/null && echo "GUEST loaded module virtio_snd"
    attempt=0
    while ! test -e /dev/snd/pcmC0D0p; do
        mdev -s
        attempt=$((attempt + 1))
        if test "$attempt" -ge 30; then
            echo "AUDIO_ERROR no playback device"
            exit 0
        fi
        sleep 1
    done
    amixer -c 0 sset Master 5% unmute > /dev/null 2>&1
    amixer -c 0 sset PCM 5% unmute > /dev/null 2>&1
    echo "AUDIO_PLAYING"
    while true; do
        aplay -q -t raw -f S16_LE -r 48000 -c 2 /dev/zero > /dev/null 2>&1
        sleep 1
    done
) &

# --- agent stack: dbus, spice-vdagentd, Xorg (modesetting on virtio-gpu), spice-vdagent ---
agent_failed() { echo "AGENT_ERROR $1"; }
dbus-uuidgen --ensure=/etc/machine-id
dbus-daemon --system --fork --nopidfile
attempt=0
while ! test -e /dev/virtio-ports/com.redhat.spice.0; do
    mdev -s
    attempt=$((attempt + 1))
    if test "$attempt" -ge 30; then agent_failed "virtio port unavailable"; break; fi
    sleep 1
done
if test -e /dev/virtio-ports/com.redhat.spice.0; then
    spice-vdagentd --foreground --one-session &
    # Xorg finds input devices through udev and nothing else. devtmpfs creates the
    # /dev/input nodes, which is why the gate's evdev reader has always worked, but
    # without a running udevd the server starts with zero input devices and no X
    # client ever sees a key. spice-vdagent's tablet appears only after a client
    # connects, so this has to be hotplug, not a static device list.
    udevd --daemon 2> /dev/null || agent_failed "udevd unavailable"
    udevadm trigger --action=add > /dev/null 2>&1 || true
    udevadm settle --timeout=10 > /dev/null 2>&1 || true
    for device in /sys/class/input/event*/device/name; do
        test -r "$device" && echo "GUEST input device $(basename "$(dirname "$(dirname "$device")")"): $(cat "$device")"
    done
    Xorg :0 -ac -noreset -nolisten tcp -logfile /tmp/Xorg.0.log -config /etc/X11/xorg.conf &
    attempt=0
    while ! test -S /tmp/.X11-unix/X0; do
        attempt=$((attempt + 1))
        if test "$attempt" -ge 30; then agent_failed "Xorg unavailable"; tail -n 50 /tmp/Xorg.0.log 2>/dev/null; break; fi
        sleep 1
    done
fi
if test -S /tmp/.X11-unix/X0; then
    # Xorg adds its udev devices after the socket appears, not before, so counting
    # once on the first look samples a number that is still climbing (measured: 1 of
    # 3 runs reported one device and failed the gate, with both present moments
    # later). Wait for both, then report whatever the count actually settled on.
    xorg_inputs=0
    attempt=0
    while test "$attempt" -lt 20; do
        xorg_inputs="$(grep -c 'Adding input device' /tmp/Xorg.0.log 2> /dev/null || echo 0)"
        test "$xorg_inputs" -ge 2 && break
        attempt=$((attempt + 1))
        sleep 1
    done
    echo "GUEST xorg input devices: $xorg_inputs"
    mkdir -p /tmp/incoming
    dbus-run-session -- sh -c 'exec spice-vdagent --foreground --file-xfer-save-dir=/tmp/incoming' &
    # Key observer, one layer above the evdev reader. The evdev reader proves a key
    # reached this kernel; it proved exactly that while Xorg ran with no input
    # devices at all and no X client could be typed into. This reports what an X
    # client actually receives. No window manager runs, so focus is PointerRoot and
    # key events go to the root window, which is what xev selects on.
    (
        xev -root 2> /dev/null | awk '
            /^KeyPress event/ { want = 1; next }
            want {
                code = ""; sym = ""
                for (i = 1; i <= NF; i++) {
                    if ($i == "keycode") code = $(i + 1)
                    if ($i == "(keysym") { sym = $(i + 1); sub(/,$/, "", sym) }
                }
                if (code != "") { print "XKEY_PRESS keycode=" code " keysym=" sym; fflush(); want = 0 }
            }
        '
    ) &
    # AGENT_STACK_STARTED is what run.sh waits for before the tests connect, so the
    # observer has to be selecting on the root before that marker, not after it: the
    # transport test injects its key seconds later and a late xev misses it outright.
    xev_ready=0
    attempt=0
    while test "$attempt" -lt 15; do
        for process in /proc/[0-9]*; do
            if grep -qs '^xev$' "$process/comm"; then xev_ready=1; break; fi
        done
        test "$xev_ready" = 1 && break
        attempt=$((attempt + 1))
        sleep 1
    done
    if test "$xev_ready" = 1; then
        echo "XKEY_OBSERVER_READY"
    else
        agent_failed "xev key observer did not start"
    fi
    echo "AGENT_STACK_STARTED"
    # Demo only: SPICE_CLIENT_LIVE_PEER_DEMO=1 makes run.sh put spice_demo=1 on
    # the kernel command line. Nothing in the gate sets it, so the guest the
    # tests observe stays a bare X server with no client that paints — which is
    # why its session window is legitimately black. This paints the root and
    # opens a terminal so a person can see and type into the guest.
    if grep -q 'spice_demo=1' /proc/cmdline; then
        xsetroot -solid '#12263a' 2> /dev/null || echo "DEMO_ERROR xsetroot failed"
        xterm -fn fixed -geometry 80x24+48+48 -fg '#e8e8e8' -bg '#101820' \
            -title 'live peer' > /tmp/xterm.log 2>&1 &
        demo_pid=$!
        # Report what actually happened: a terminal that dies on a missing font
        # would otherwise leave the same black screen this path exists to fix.
        sleep 2
        if kill -0 "$demo_pid" 2> /dev/null; then
            echo "DEMO_DESKTOP_STARTED"
        else
            echo "DEMO_ERROR xterm exited: $(tail -n 3 /tmp/xterm.log 2> /dev/null | tr '\n' ' ')"
        fi
    fi
    # Clipboard observer: log every change; answer a host token with a guest token.
    (
        last=""
        while true; do
            if ! text="$(xclip -selection clipboard -out 2>/dev/null)"; then
                if test -n "$last"; then last=""; echo "CLIPBOARD_CLEARED"; fi
            else
                sum="$(printf '%s' "$text" | sha256sum | cut -d ' ' -f 1)"
                if test "$sum" != "$last"; then
                    last="$sum"
                    echo "CLIPBOARD_OBSERVED bytes=$(printf '%s' "$text" | wc -c | tr -d ' ') sha256=$sum"
                    case "$text" in
                        "spice-client host clipboard "*)
                            token="${text#spice-client host clipboard }"
                            printf 'spice-client guest clipboard %s' "$token" | xclip -selection clipboard -in &
                            echo "CLIPBOARD_OFFERED $token"
                            ;;
                    esac
                fi
            fi
            sleep 0.5
        done
    ) &
    # File observer: vdagent writes a transfer as its chunks arrive, so a poller
    # that hashes on sight hashes a partial file. Report once the size has been
    # stable, and always report by the deadline so a stuck transfer produces a
    # line rather than silence.
    (
        while true; do
            for file in /tmp/incoming/*; do
                test -f "$file" || continue
                name="$(basename "$file")"
                test -e "/tmp/reported-$name" && continue
                touch "/tmp/reported-$name"
                (
                    # vdagent allocates the full size up front, so the size is
                    # settled from the first instant and says nothing. The
                    # modification time moves with every chunk, so that is the
                    # signal; the deadline always produces a line.
                    previous=""
                    stable=0
                    waited=0
                    while test "$waited" -lt 60; do
                        current="$(stat -c %Y "$file" 2>/dev/null)"
                        test -n "$current" || break
                        if test "$current" = "$previous"; then
                            stable=$((stable + 1))
                        else
                            stable=0
                        fi
                        test "$stable" -ge 2 && break
                        previous="$current"
                        waited=$((waited + 1))
                        sleep 1
                    done
                    if test -f "$file"; then
                        test "$waited" -ge 60 && echo "FILE_TRANSFER_DEADLINE name=$name"
                        echo "FILE_TRANSFER_RECEIVED name=$name bytes=$(wc -c < "$file" | tr -d ' ') sha256=$(sha256sum "$file" | cut -d' ' -f1)"
                    else
                        # The agent removed it: a failed transfer, not a delivery.
                        echo "FILE_TRANSFER_REMOVED name=$name"
                    fi
                ) &
            done
            sleep 1
        done
    ) &

    # Mode observer: apply the preferred mode of Virtual-1 whenever it changes.
    (
        last=""
        while true; do
            mode="$(xrandr --query 2>/dev/null | awk '/^Virtual-1 connected/{f=1; next} /^[^ ]/{f=0} f && /\+/{print $1; exit}')"
            if test -n "$mode" && test "$mode" != "$last"; then
                # The X screen must follow the output: the scanout the SPICE server
                # exports is the screen, so an output-only mode change leaves the
                # client's surface at its old size.
                if xrandr --fb "$mode" --output Virtual-1 --mode "$mode" 2>/dev/null; then
                    last="$mode"
                    echo "XRANDR_MODE $mode"
                    echo "XRANDR_SCREEN $(xrandr --query 2>/dev/null | sed -n 's/^Screen 0:.*current \([0-9]*\) x \([0-9]*\).*/\1x\2/p')"
                fi
            fi
            sleep 0.5
        done
    ) &
fi
while true; do sleep 60; done
