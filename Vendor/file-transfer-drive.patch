# Local change 3 of 3 (spice-client ADR-0005), on top of patches 1 and 2.
#
# Serialises the file-transfer drive. Concurrent drives interleave at their
# await points and invalidate each other's commit check, so a multi-chunk
# transfer re-sends one offset for ever and the guest fails on duplicate data.
diff --git a/Sources/SwiftSpice/SpiceClipboardManager.swift b/Sources/SwiftSpice/SpiceClipboardManager.swift
--- a/Sources/SwiftSpice/SpiceClipboardManager.swift
+++ b/Sources/SwiftSpice/SpiceClipboardManager.swift
